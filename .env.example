# Copy to .env (gitignored). These values are used on your machine only and never ship to the browser.
#
# Do NOT put secrets in the frontend. Anything the Angular app itself uses ends up in the JavaScript
# bundle, which anyone can read. Cognito and Cloudinary secrets belong in roleveya-be/.env.

# Where `npm start` forwards /api requests (the backend from roleveya-be).
API_PROXY_TARGET=http://127.0.0.1:8000
